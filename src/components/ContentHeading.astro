---
import { t, toLocalePath, type Locale } from '../i18n/ui';
interface Props { title: string; description: string; image?: string; imageAlt?: string; imagePosition?: string; caption?: string; eyebrow?: string; variant?: 'corporate'|'news'|'projects'|'tech'; lang?: Locale; }
const {title,description,image,imageAlt='',imagePosition='center 45%',eyebrow,variant='tech',lang='zh'}=Astro.props;
const strings=t(lang);
const heroImage=image||(variant==='corporate'?'/media/c59278af44d3cd75.jpg':variant==='news'?'/media/0574736402e19061.jpg':'/media/bdba09e13042f80b.jpg');
const label=eyebrow||(variant==='corporate'?'ABOUT GSIN':variant==='news'?'GSIN NEWS':variant==='projects'?'BUSINESS & PROJECTS':'TECHNOLOGY & INNOVATION');
---
<section class="page-hero">
 <img src={heroImage} alt={imageAlt||title} style={{objectPosition:imagePosition}} fetchpriority="high"/>
 <div class="wrap page-hero-copy"><nav aria-label={strings.breadcrumb.aria}><a href={toLocalePath(lang,'/')}>{strings.breadcrumb.home}</a><span>/</span><span>{title}</span></nav><p>{label}</p><h1>{title}</h1><div class="page-hero-description">{description}</div><div class="page-hero-extra"><slot/></div></div>
</section>
<style>
.page-hero{position:relative;height:420px;overflow:hidden;color:#fff;background:#203c32}.page-hero>img{width:100%;height:100%;object-fit:cover;object-position:center 45%}.page-hero:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(9,31,24,.73),rgba(9,31,24,.05) 80%)}.page-hero-copy{position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;justify-content:center;padding:30px 40px}.page-hero-copy nav{display:flex;gap:14px;font-size:12px;color:#e0e8e1;margin-bottom:38px}.page-hero-copy a{color:inherit}.page-hero-copy>p{font-size:12px;letter-spacing:.22em;margin:0 0 12px;color:#fff}.page-hero-copy h1{font-size:48px;line-height:1.2;font-weight:400;margin:0 0 18px;letter-spacing:.05em;color:#fff}.page-hero-description{font-size:19px;letter-spacing:.06em;max-width:800px;line-height:1.8}.page-hero-extra:empty{display:none}.page-hero-extra{margin-top:18px}.page-hero-extra :global(.heading-fact){color:#fff;margin:0;font-size:13px}
@media(min-width:1600px){.page-hero{height:470px}}@media(max-width:700px){.page-hero{height:350px}.page-hero-copy{padding:20px}.page-hero-copy h1{font-size:36px}.page-hero-description{font-size:16px}.page-hero-copy nav{margin-bottom:25px}}
</style>
