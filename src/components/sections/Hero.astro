---
import company from "../../data/company.json";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
---

<section class="relative overflow-hidden py-20 sm:py-28">
  <div class="absolute inset-x-0 top-0 h-[70%] bg-gradient-to-b from-[#e8efff] to-transparent" aria-hidden="true"></div>
  <Container class="relative grid items-center gap-14 lg:grid-cols-[1fr_.82fr] lg:gap-20">
    <div>
      <p class="mb-6 inline-flex rounded-full border border-[#c3d3e0] bg-white px-4 py-2 text-xs font-extrabold tracking-[0.14em] text-[var(--color-primary)]">钢结构工程建造</p>
      <h1 class="max-w-4xl text-4xl font-extrabold leading-[1.16] sm:text-6xl">{company.tagline}</h1>
      <p class="mt-7 max-w-2xl text-lg leading-9 text-[var(--color-muted)]">{company.description}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <Button href="/projects/">查看工程案例</Button>
        <Button href="/contact/" variant="secondary">联系我们</Button>
      </div>
    </div>
    <div class="relative rounded-[2rem] bg-[var(--color-ink)] p-5 shadow-[var(--shadow-card)] sm:p-7">
      <img src="/media/company/hero-super-high-rise.jpg" alt="深湾汇云中心超高层塔楼与深圳湾城市天际线" width="1920" height="1358" class="w-full rounded-2xl" />
      <div class="grid gap-3 pt-4 sm:grid-cols-2">
        <div class="rounded-2xl bg-white/10 p-5 text-white">
          <p class="text-xs font-bold tracking-[.14em] text-[var(--color-accent)]">总部所在地</p>
          <p class="mt-2 font-extrabold">{company.location}</p>
        </div>
        <div class="rounded-2xl bg-[var(--color-primary)] p-5 text-white">
          <p class="text-xs font-bold tracking-[.14em] text-white/65">成立时间</p>
          <p class="mt-2 font-extrabold">{company.founded}</p>
        </div>
      </div>
    </div>
  </Container>
</section>
