---
import { getPublishedProjects } from "../../lib/projects";
import ProjectCard from "../project/ProjectCard.astro";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const projects = (await getPublishedProjects()).filter((project) => project.data.featured).slice(0, 6);
---

<section class="bg-[var(--color-surface)] py-24 sm:py-32">
  <Container>
    <div class="flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-end">
      <SectionHeading eyebrow="工程案例" title="以建成的项目说明工程能力。" description="从超高层到体育馆、医院过渡用房与住宅产品，每个案例都附带项目资料与现场图片。" />
      <Button href="/projects/" variant="secondary" class="shrink-0">全部案例</Button>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </Container>
</section>
