---
import { siteConfig } from "../../site.config";
import { localeMeta, type Locale } from "../i18n/ui";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  lang?: Locale;
}

const { title, description, image, noindex = false, lang = "zh" } = Astro.props;
const shouldIndex = siteConfig.siteMode === "production" && !noindex;
// Match the final clean-route directories while retaining legacy .html URLs.
let canonicalPath = Astro.url.pathname;
if (canonicalPath.endsWith("/index.html")) {
  canonicalPath = canonicalPath.slice(0, -"index.html".length);
} else if (canonicalPath.endsWith(".html")) {
  const preservedFile = /^(?:\/en)?\/(?:article|page|download)\//.test(canonicalPath)
    || /^\/(?:404|500)\.html$/.test(canonicalPath);
  if (!preservedFile) canonicalPath = canonicalPath.replace(/\.html$/, "/");
} else if (!canonicalPath.endsWith("/")) {
  canonicalPath += "/";
}
const canonical = siteConfig.siteUrl ? new URL(canonicalPath, siteConfig.siteUrl).toString() : undefined;
const socialImage = image && siteConfig.siteUrl ? new URL(image, siteConfig.siteUrl).toString() : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={shouldIndex ? "index,follow" : "noindex,nofollow"} />
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:type" content="website" />
<meta property="og:locale" content={localeMeta[lang].ogLocale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{socialImage && <meta property="og:image" content={socialImage} />}
<meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
