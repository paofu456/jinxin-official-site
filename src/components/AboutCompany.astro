---
import dataZh from '../data/corporate-presentation.json';
import dataEn from '../data/corporate-presentation-en.json';
import companyEn from '../data/company-en.json';
import { getCompany, t, toLocalePath, type Locale } from '../i18n/ui';
import ContentHeading from './ContentHeading.astro';
interface Props { submenu: {label:string;href:string}[]; lang?: Locale; }
const {submenu, lang='zh'}=Astro.props;
const strings=t(lang).about;
const company=getCompany(lang);
const data=lang==='en'?dataEn:dataZh;
const paragraphs=lang==='en'?data.aboutParagraphs:data.aboutParagraphs.map(html=>html.replace('被被认定','被认定').replace(/<span \"=\"\">/g,'<span>'));
const subnav=lang==='en'?t('en').records.aboutSubnav:submenu;
const profileHighlights=lang==='en'?companyEn.profileHighlights:[];
---
<ContentHeading title={strings.headingTitle} description={strings.headingDescription} image={data.aboutImages[0].src} imageAlt={lang==='en'?'GSIN steel structure building':'金鑫钢结构建筑'} variant="corporate" lang={lang}/>
<nav class="company-nav" aria-label={t(lang).records.subnavAria}><div class="wrap">{subnav.map(item=><a href={item.href} aria-current={item.label===strings.profileEyebrow?'page':undefined}>{item.label}</a>)}</div></nav>
{profileHighlights.length>0&&<section class="company-snapshot" aria-labelledby="company-snapshot-title"><div class="wrap company-snapshot-grid"><div class="company-snapshot-lead"><p>{strings.snapshotEyebrow}</p><h2 id="company-snapshot-title">{strings.snapshotHeading}</h2><div class="company-snapshot-links"><a href={toLocalePath(lang,'/article/zzzs.html')}>{strings.snapshotCertifications}</a><a href={toLocalePath(lang,'/projects/')}>{strings.snapshotProjects}</a></div></div><dl aria-label={strings.snapshotAria}>{profileHighlights.map(item=><div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl></div></section>}
<section class="wrap company-profile">
 <div class="company-section-title"><p>{strings.profileEyebrow}</p><h2>{strings.profileHeadingLines[0]}<br/>{strings.profileHeadingLines[1]}</h2><span>{company.name}</span></div>
 <article class="company-copy" set:html={paragraphs[0]}/>
</section>
<section class="wrap company-values" aria-label={strings.valuesAria}>{strings.values.map((value,i)=><div><span>0{i+1}</span><h2>{value.title}</h2><p>{value.text}</p></div>)}</section>
<section class="company-practice"><div class="wrap company-practice-grid"><figure><img src="/media/projects/shenzhen-bay-one-01.jpg" alt={lang==='en'?'One Shenzhen Bay':'鹏瑞深圳湾壹号'} loading="lazy"/><figcaption>{lang==='en'?'One Shenzhen Bay':'鹏瑞深圳湾壹号'}</figcaption></figure><div><div class="company-section-title"><p>{strings.practiceEyebrow}</p><h2>{strings.practiceHeadingLines[0]}<br/>{strings.practiceHeadingLines[1]}</h2></div><article class="company-copy" set:html={paragraphs[1]}/><article class="company-copy company-awards" set:html={paragraphs[2]}/><a class="company-link" href={toLocalePath(lang,'/projects/')}>{strings.practiceLink}</a></div></div></section>
<section class="wrap company-research"><div class="company-section-title"><p>{strings.researchEyebrow}</p><h2>{strings.researchHeadingLines[0]}<br/>{strings.researchHeadingLines[1]}</h2></div><div><article class="company-copy" set:html={paragraphs[4]}/><article class="company-copy" set:html={paragraphs[5]}/><p class="company-copy">{strings.researchExtra}</p><a class="company-link" href={toLocalePath(lang,'/page/zpsgjgqbjztx.html')}>{strings.researchLink}</a></div></section>
<section class="company-achievement"><div class="wrap"><div class="company-achievement-heading"><div class="company-section-title"><p>{strings.achievementEyebrow}</p><h2>{strings.achievementHeadingLines[0]}<br/>{strings.achievementHeadingLines[1]}</h2></div><a href={toLocalePath(lang,'/download/jszl.html')} class="company-link">{strings.achievementLink}</a></div><article class="company-copy" set:html={paragraphs[3]}/><nav aria-label={strings.furtherAria}>{strings.further.map(item=><a href={toLocalePath(lang,item.href)}>{item.label}</a>)}</nav></div></section>
<style>
.company-snapshot{background:#f3f6f2;border-bottom:1px solid #dfe7e0}.company-snapshot-grid{display:grid;grid-template-columns:300px 1fr;gap:74px;align-items:start;padding:48px 40px 52px}.company-snapshot-lead>p{font-size:13px;color:#25845c;letter-spacing:.1em;margin:0 0 15px}.company-snapshot-lead h2{font-size:27px;line-height:1.5;font-weight:400;color:#243c31;margin:0}.company-snapshot-links{display:flex;flex-wrap:wrap;gap:22px;margin-top:24px}.company-snapshot-links a{font-size:14px;color:#207b52;border-bottom:1px solid #82aa90;padding:6px 0}.company-snapshot dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;margin:0;border-top:1px solid #ccd8d0}.company-snapshot dl>div{padding:18px 28px 20px 0;border-bottom:1px solid #ccd8d0}.company-snapshot dl>div:nth-child(odd){margin-right:28px;border-right:1px solid #d9e2dc}.company-snapshot dt{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#25845c;margin-bottom:8px}.company-snapshot dd{margin:0;font-size:15px;line-height:1.75;color:#34483e}
.company-nav{border-bottom:1px solid #e4e9e5;background:#fff}.company-nav>.wrap{display:flex;gap:52px}.company-nav a{position:relative;padding:25px 0;font-size:15px;color:#47524b}.company-nav a[aria-current=page]{color:#218457}.company-nav a[aria-current=page]:after{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;background:#32b372}.company-profile,.company-research{display:grid;grid-template-columns:1fr 1.8fr;gap:90px;padding:78px 40px 65px}.company-section-title>p{font-size:13px;color:#25845c;letter-spacing:.1em;margin:0 0 17px}.company-section-title h2{font-size:34px;line-height:1.55;font-weight:400;letter-spacing:.01em;color:#243c31;margin:0 0 24px}.company-section-title>span{font-size:14px;color:#758179}.company-copy{font-size:16px;line-height:2.15;color:#56645d}.company-copy :global(p){font-size:inherit;line-height:inherit;margin:0 0 20px;color:inherit}.company-copy :global(span){color:inherit!important;font-size:inherit!important}.company-values{display:grid;grid-template-columns:repeat(3,1fr);padding:0 40px 75px;gap:50px}.company-values>div{border-top:1px solid #cbd8d0;padding:24px 0}.company-values span{color:#6a9d81;font-size:13px}.company-values h2{font-size:22px;font-weight:400;margin:12px 0;color:#263f31}.company-values p{font-size:14px;color:#758179;margin:0}.company-practice{background:#f2f5f1;padding:80px 0}.company-practice-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;padding:0 40px}.company-practice figure{position:relative;margin:0;height:620px}.company-practice figure img{width:100%;height:100%;object-fit:cover}.company-practice figcaption{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,#15271c99);padding:50px 25px 24px;color:#fff;font-size:14px}.company-practice .company-copy{font-size:15px}.company-awards{padding-top:18px;border-top:1px solid #d5dfd6;margin-top:18px}.company-link{display:inline-block;color:#207b52;border-bottom:1px solid #82aa90;padding:7px 0;font-size:14px}.company-research{padding-top:90px;padding-bottom:90px}.company-research .company-copy+.company-copy{margin-top:20px}.company-achievement{padding:75px 0;background:#f2f5f1;color:#243c31}.company-achievement>.wrap{padding:0 40px}.company-achievement-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.company-achievement .company-section-title h2{color:#243c31}.company-achievement .company-section-title>p{color:#25845c}.company-achievement .company-copy{color:#56645d;max-width:1100px}.company-achievement .company-link{color:#207b52;border-color:#82aa90}.company-achievement nav{display:flex;gap:50px;border-top:1px solid #d5dfd6;margin-top:35px;padding-top:30px}.company-achievement nav a{color:#47524b;font-size:15px}.company-nav a:hover,.company-link:hover{color:#32b372}.company-achievement nav a:hover{color:#25845c} @media(max-width:1000px){.company-profile,.company-research{gap:35px;padding-left:0;padding-right:0}.company-practice-grid{gap:35px;padding:0}.company-values{padding-left:0;padding-right:0;gap:25px}.company-practice figure{height:600px}.company-achievement>.wrap{padding:0}} @media(max-width:700px){.company-nav>.wrap{gap:25px;overflow:auto;white-space:nowrap}.company-profile,.company-research,.company-practice-grid{grid-template-columns:1fr;gap:25px}.company-profile,.company-research{padding-top:45px;padding-bottom:35px}.company-section-title h2{font-size:28px}.company-values{grid-template-columns:1fr;gap:0;padding-bottom:30px}.company-values>div{padding:18px 0}.company-practice{padding:35px 0}.company-practice figure{height:400px}.company-achievement{padding:40px 0}.company-achievement-heading{display:block}.company-achievement nav{flex-wrap:wrap;gap:25px}.company-copy{font-size:15px}}
@media(max-width:1000px){.company-snapshot-grid{grid-template-columns:240px 1fr;gap:40px;padding-left:0;padding-right:0}}@media(max-width:700px){.company-snapshot-grid{grid-template-columns:1fr;gap:26px;padding:30px 0 36px}.company-snapshot-lead h2{font-size:24px}.company-snapshot dl{grid-template-columns:1fr}.company-snapshot dl>div:nth-child(odd){margin-right:0;border-right:0}.company-snapshot dl>div{padding-right:0}}
</style>
