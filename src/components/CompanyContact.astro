---
import ContentHeading from './ContentHeading.astro';
import archive from '../data/archive.json';
import { getCompany, t, type Locale } from '../i18n/ui';
import { siteConfig } from '../../site.config';
interface Props { lang?: Locale; }
const {lang='zh'}=Astro.props;
const company=getCompany(lang);
const strings=t(lang).contact;
const page=archive.find(p=>p.path==='/page/lxwm.html')!;
const mapUrl=page.html.match(/class="contact-addr" href="([^"]+)"/)?.[1].replaceAll('&amp;','&');
const submenu=lang==='en'?t('en').records.aboutSubnav:page.submenu;
const messages={sending:strings.formSending,success:strings.formSuccess,error:strings.formError,unknown:strings.formUnknown,unavailable:strings.formUnavailable,rateLimited:strings.formRateLimited};
---
<ContentHeading title={strings.title} description={company.name} variant="corporate" lang={lang}/>
<nav class="record-navigation wrap" aria-label={t(lang).records.subnavAria}>{submenu.map(item=><a href={item.href} aria-current={item.label===strings.title?'page':undefined}>{item.label}</a>)}</nav>
<section class="company-contact"><div class="company-contact-inner wrap">
 <div class="contact-welcome"><h2>{strings.welcomeHeading}</h2><p>{strings.welcomeText}</p><p class="contact-hotline">{strings.hotline}<a href={'tel:'+company.phone}>{company.phone}</a></p>
 <form class="company-message" data-endpoint={siteConfig.inquiry.endpoint} data-language={lang} data-messages={JSON.stringify(messages)}>
  <div class="company-message-fields"><label><span class="sr-only">{strings.formName}</span><input name="name" aria-label={strings.formName} placeholder={strings.formName} autocomplete="name" maxlength="100" required/></label><label><span class="sr-only">{strings.formPhone}</span><input name="phone" type="tel" aria-label={strings.formPhone} placeholder={strings.formPhone} autocomplete="tel" maxlength="60" required/></label><label><span class="sr-only">{strings.formEmail}</span><input name="email" type="email" aria-label={strings.formEmail} placeholder={strings.formEmail} autocomplete="email" maxlength="254" required/></label><label><span class="sr-only">{strings.formFax}</span><input name="fax" type="tel" aria-label={strings.formFax} placeholder={strings.formFax} maxlength="60"/></label></div>
  <label class="company-message-text"><span class="sr-only">{strings.formMessage}</span><textarea name="message" aria-label={strings.formMessage} placeholder={strings.formMessage} maxlength="4000" required rows="6"></textarea></label>
  <div class="company-message-trap" aria-hidden="true"><input name="website" type="text" tabindex="-1" autocomplete="off" aria-label="Leave empty"/></div>
  <div class="company-message-submit"><button type="submit" disabled>{strings.formSubmit}</button><p>{strings.formNote}</p><p data-inquiry-status role="status" aria-live="polite" aria-atomic="true">{strings.formUnavailable}</p></div>
 </form></div>
 <div class="contact-company-details"><h2>{strings.detailsHeading}</h2><figure><img src="/media/73854ec81b2ffc2e.png" alt={strings.wechatQrAlt} width="100" height="100"/><figcaption>{strings.wechatCaption}</figcaption></figure><dl><div><dt>{strings.labelPhone}</dt><dd><a href={'tel:'+company.phone}>{company.phone}</a></dd></div><div><dt>{strings.labelFax}</dt><dd>{company.fax}</dd></div><div><dt>{strings.labelEmail}</dt><dd><a href={'mailto:'+company.email}>{company.email}</a></dd></div><div><dt>{strings.labelAddress}</dt><dd>{company.address}</dd></div><div><dt>{strings.labelPostcode}</dt><dd>{company.postcode}</dd></div></dl>{mapUrl&&<a class="company-map-link" href={mapUrl} target="_blank" rel="noopener"><svg width="20" height="24" viewBox="0 0 24 28" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 26S3 16 3 10a9 9 0 0 1 18 0c0 6-9 16-9 16Z"/><circle cx="12" cy="10" r="3"/></svg>{strings.mapLink}</a>}</div>
 </div></section>
<script>
import { mountInquiryForm } from '../lib/inquiry';
document.querySelectorAll<HTMLFormElement>('.company-message').forEach(mountInquiryForm);
</script>
<style>
.company-message button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-width:128px;transition:background .2s,transform .2s,box-shadow .2s}
.company-message button:not(:disabled):hover{transform:translateY(-2px);box-shadow:0 6px 16px #16704b25}
.company-message button:not(:disabled):active{transform:translateY(0)}
.company-message[aria-busy="true"] button::before{content:'';width:14px;height:14px;border:2px solid #ffffff60;border-top-color:#fff;border-radius:50%;animation:contact-spin .8s linear infinite}
.company-message .company-message-submit [data-inquiry-status]:not([hidden]){display:flex;align-items:flex-start;gap:12px;padding:16px 18px;margin-top:18px;border:1px solid #cbded2;background:#f1f8f3;border-radius:4px;font-size:14px;line-height:1.8;animation:contact-feedback .25s ease-out}
.company-message [data-inquiry-status]::before{flex-shrink:0;display:grid;place-items:center;width:24px;height:24px;border:1px solid currentColor;border-radius:50%;font-size:15px;line-height:1}
.company-message [data-inquiry-status][data-state="pending"]::before{content:'';width:18px;height:18px;margin-top:3px;border:2px solid #bdd1c5;border-top-color:#258253;animation:contact-spin .8s linear infinite}
.company-message [data-inquiry-status][data-state="success"]::before{content:'✓'}
.company-message [data-inquiry-status][data-state="error"]::before{content:'!'}
.company-message .company-message-submit [data-inquiry-status][data-state="error"]{background:#fff5f3;border-color:#edcdc5}
.company-message [data-inquiry-status]:focus-visible{outline:2px solid currentColor;outline-offset:3px}
@keyframes contact-spin{to{transform:rotate(360deg)}}
@keyframes contact-feedback{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
@media(prefers-reduced-motion:reduce){.company-message button{transition:none}.company-message button:not(:disabled):hover{transform:none}.company-message [data-inquiry-status],.company-message [data-inquiry-status]::before,.company-message button::before{animation:none!important}}
.company-message-trap{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}.company-message button:disabled{opacity:.6;cursor:wait}.company-message [data-inquiry-status][data-state="error"]{color:#9f2929}.company-message [data-inquiry-status][data-state="success"]{color:#207747}
.company-contact{background:url('/replica/skin/jx/images/contact_bg.jpg') center top/cover no-repeat;padding:72px 0 80px}.company-contact-inner{display:grid;grid-template-columns:1fr 1fr;max-width:1200px;gap:80px}.company-contact h2{font-size:30px;line-height:1.5;font-weight:400;color:#383f3a;margin:0 0 8px}.contact-welcome>p{font-size:14px;line-height:1.9;color:#747b76;margin:8px 0}.contact-hotline a{font-family:Arial,sans-serif;font-weight:600;color:inherit}.company-message{margin-top:35px}.company-message-fields{display:grid;grid-template-columns:1fr 1fr;gap:20px}.company-message input,.company-message textarea{display:block;width:100%;box-sizing:border-box;border:1px solid transparent;border-radius:0;background:#00000012;font:inherit;font-size:14px;color:#3a423c;padding:15px 18px}.company-message input{height:50px}.company-message input::placeholder,.company-message textarea::placeholder{color:#636c65}.company-message input:focus,.company-message textarea:focus{outline:2px solid #32b372;outline-offset:2px;background:#ffffffa8}.company-message-text{display:block;margin-top:20px}.company-message textarea{height:164px;resize:vertical}.company-message-submit{margin-top:20px}.company-message button{padding:14px 35px;border:1px solid #32b372;background:#32b372;color:#fff;font-size:14px;cursor:pointer}.company-message button:hover{background:#258c59}.company-message-submit p{font-size:12px;color:#747b76;line-height:1.8;margin:10px 0 0}.contact-company-details figure{margin:19px 0 25px;width:100px;text-align:center}.contact-company-details figure img{width:100px;height:100px;display:block}.contact-company-details figcaption{font-size:13px;color:#677169;margin-top:9px}.contact-company-details dl{margin:0}.contact-company-details dl>div{display:flex;gap:2px;font-size:16px;line-height:1.8;color:#747b76;margin:12px 0}.contact-company-details dt{white-space:nowrap}.contact-company-details dd{margin:0;overflow-wrap:anywhere}.contact-company-details a{color:inherit}.contact-company-details a:hover{color:#268b5b}.company-map-link{display:inline-flex;align-items:center;gap:8px;font-size:16px;margin-top:13px}.company-map-link svg{color:#32b372}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:1000px){.company-contact-inner{gap:45px}}@media(max-width:700px){.company-contact{padding:35px 0 45px}.company-contact-inner{grid-template-columns:1fr;gap:45px}.company-contact h2{font-size:26px}.company-message-fields{gap:14px}}
</style>
