---
import ContentHeading from './ContentHeading.astro';
import company from '../data/company.json';
import archive from '../data/archive.json';
const page=archive.find(p=>p.path==='/page/lxwm.html')!;
const mapUrl=page.html.match(/class="contact-addr" href="([^"]+)"/)?.[1].replaceAll('&amp;','&');
---
<ContentHeading title="联系我们" description={company.name}/>
<nav class="record-navigation wrap" aria-label="栏目导航">{page.submenu.map(item=><a href={item.href} aria-current={item.label==='联系我们'?'page':undefined}>{item.label}</a>)}</nav>
<section class="company-contact"><div class="company-contact-inner wrap">
 <div class="contact-welcome"><h2>欢迎来到金鑫绿建</h2><p>公司秉承“诚信、勤奋、感恩、创新”的核心价值观，为顾客提供专业、优质的服务。如果您有任何意见，请发邮件给我们。</p><p class="contact-hotline">全国客户热线：<a href={'tel:'+company.phone}>{company.phone}</a></p>
 <form class="company-message" data-email={company.email}>
  <div class="company-message-fields"><label><span class="sr-only">姓名</span><input name="name" aria-label="姓名" placeholder="姓名" autocomplete="name" required/></label><label><span class="sr-only">电话</span><input name="phone" type="tel" aria-label="电话" placeholder="电话" autocomplete="tel" required/></label><label><span class="sr-only">邮箱</span><input name="email" type="email" aria-label="邮箱" placeholder="邮箱" autocomplete="email" required/></label><label><span class="sr-only">传真</span><input name="fax" type="tel" aria-label="传真（选填）" placeholder="传真（选填）"/></label></div>
  <label class="company-message-text"><span class="sr-only">留言</span><textarea name="message" aria-label="留言" placeholder="留言" required rows="6"></textarea></label><div class="company-message-submit"><button type="submit">发送留言邮件</button><p>填写后将打开邮箱客户端，由您确认发送。</p></div>
 </form></div>
 <div class="contact-company-details"><h2>联系我们</h2><figure><img src="/media/73854ec81b2ffc2e.png" alt="金鑫绿建微信公众号二维码" width="100" height="100"/><figcaption>微信公众号</figcaption></figure><dl><div><dt>电话：</dt><dd><a href={'tel:'+company.phone}>{company.phone}</a></dd></div><div><dt>传真：</dt><dd>{company.fax}</dd></div><div><dt>邮箱：</dt><dd><a href={'mailto:'+company.email}>{company.email}</a></dd></div><div><dt>公司地址：</dt><dd>{company.address}</dd></div><div><dt>邮编：</dt><dd>{company.postcode}</dd></div></dl>{mapUrl&&<a class="company-map-link" href={mapUrl} target="_blank" rel="noopener"><svg width="20" height="24" viewBox="0 0 24 28" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 26S3 16 3 10a9 9 0 0 1 18 0c0 6-9 16-9 16Z"/><circle cx="12" cy="10" r="3"/></svg>进入百度地图</a>}</div>
 </div></section>
<script>
const messageForm=document.querySelector<HTMLFormElement>('.company-message');
messageForm?.addEventListener('submit',event=>{event.preventDefault();if(!messageForm.reportValidity())return;const data=new FormData(messageForm);const body=[`姓名：${data.get('name')}`,`电话：${data.get('phone')}`,`邮箱：${data.get('email')}`,`传真：${data.get('fax')||''}`,'',String(data.get('message'))].join('\n');window.location.href=`mailto:${messageForm.dataset.email}?subject=${encodeURIComponent('官网留言 — '+data.get('name'))}&body=${encodeURIComponent(body)}`;});
</script>
<style>
.company-contact{background:url('/replica/skin/jx/images/contact_bg.jpg') center top/cover no-repeat;padding:72px 0 80px}.company-contact-inner{display:grid;grid-template-columns:1fr 1fr;max-width:1200px;gap:80px}.company-contact h2{font-size:30px;line-height:1.5;font-weight:400;color:#383f3a;margin:0 0 8px}.contact-welcome>p{font-size:14px;line-height:1.9;color:#747b76;margin:8px 0}.contact-hotline a{font-family:Arial,sans-serif;font-weight:600;color:inherit}.company-message{margin-top:35px}.company-message-fields{display:grid;grid-template-columns:1fr 1fr;gap:20px}.company-message input,.company-message textarea{display:block;width:100%;box-sizing:border-box;border:1px solid transparent;border-radius:0;background:#00000012;font:inherit;font-size:14px;color:#3a423c;padding:15px 18px}.company-message input{height:50px}.company-message input::placeholder,.company-message textarea::placeholder{color:#636c65}.company-message input:focus,.company-message textarea:focus{outline:2px solid #32b372;outline-offset:2px;background:#ffffffa8}.company-message-text{display:block;margin-top:20px}.company-message textarea{height:164px;resize:vertical}.company-message-submit{margin-top:20px}.company-message button{padding:14px 35px;border:1px solid #32b372;background:#32b372;color:#fff;font-size:14px;cursor:pointer}.company-message button:hover{background:#258c59}.company-message-submit p{font-size:12px;color:#747b76;line-height:1.8;margin:10px 0 0}.contact-company-details figure{margin:19px 0 25px;width:100px;text-align:center}.contact-company-details figure img{width:100px;height:100px;display:block}.contact-company-details figcaption{font-size:13px;color:#677169;margin-top:9px}.contact-company-details dl{margin:0}.contact-company-details dl>div{display:flex;gap:2px;font-size:16px;line-height:1.8;color:#747b76;margin:12px 0}.contact-company-details dt{white-space:nowrap}.contact-company-details dd{margin:0;overflow-wrap:anywhere}.contact-company-details a{color:inherit}.contact-company-details a:hover{color:#268b5b}.company-map-link{display:inline-flex;align-items:center;gap:8px;font-size:16px;margin-top:13px}.company-map-link svg{color:#32b372}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:1000px){.company-contact-inner{gap:45px}}@media(max-width:700px){.company-contact{padding:35px 0 45px}.company-contact-inner{grid-template-columns:1fr;gap:45px}.company-contact h2{font-size:26px}.company-message-fields{gap:14px}}
</style>
