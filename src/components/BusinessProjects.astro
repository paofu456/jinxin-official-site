---

import ContentHeading from './ContentHeading.astro';
import { getProjectCatalog, localizedRecordHref } from '../lib/catalog';
import { getPublishedProducts } from '../lib/products';
import {business} from '../data/business';
import { t, toLocalePath, type Locale } from '../i18n/ui';
interface Props { lang?: Locale; }
const {lang='zh'}=Astro.props;
const strings=t(lang).catalog;
const projects=getProjectCatalog(lang);
const products=await getPublishedProducts(lang);
const categories=[strings.allCategory,...business.map(b=>lang==='en'?b.en.category:b.category)];
const businessCategory=(slug:string)=>{const item=business.find(b=>b.slug===slug);return lang==='en'?item?.en.category:item?.category;};
const projectHref=(p:typeof projects[number])=>localizedRecordHref(p,'projects',lang);
const clientStrings={all:strings.allCategory,countShort:strings.countShortTemplate,countFull:strings.countFullTemplate,pageAria:strings.pageAriaTemplate,empty:strings.empty};
---
<ContentHeading title={strings.headingTitle} description={strings.headingDescription} image="/media/0f36b957eb5c58d1.jpg" imageAlt={lang==='en'?'Rendering of the Hongyun Honghe Group Xinjiang cigarette factory':'红云红河烟草集团新疆卷烟厂建筑效果图'} imagePosition="center 58%" variant="projects" lang={lang}><span class="heading-fact">{strings.headingFact(projects.length)}</span></ContentHeading>
<section class="wrap catalog-section">
<div class="catalog-tools"><div class="filter-tabs" role="group" aria-label={strings.filterAria}>{categories.map((c,i)=><button type="button" data-category={c} aria-pressed={i===0?'true':'false'}>{c}</button>)}</div><label class="catalog-search"><span>{strings.searchLabel}</span><input type="search" placeholder={strings.searchPlaceholder} aria-label={strings.searchAria}/></label></div>
<div class="integrated-business" aria-label={strings.businessEyebrow}>{products.map(p=><article data-business-category={businessCategory(p.data.slug)} hidden><div><p class="eyebrow">{strings.businessEyebrow}</p><h2>{p.data.title}</h2><p>{p.data.summary}</p><a class="text-link" href={toLocalePath(lang,`/products/${p.data.slug}/`)}>{strings.businessLink}</a></div><dl>{p.data.specifications.map(s=><div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}</dl></article>)}</div>
<p class="catalog-count" aria-live="polite">{strings.countShort(projects.length)}</p>
<div class="catalog-grid" id="project-results">{projects.map((p,i)=><a hidden={i>=12} class="catalog-card" href={projectHref(p)} data-categories={p.categories.join('|')} data-search={`${p.title} ${p.summary}`}><div class="catalog-image">{p.images[0]&&<img src={p.images[0].src} alt={p.title} loading="lazy"/>}</div><p class="catalog-category">{p.categories.join(' · ')}</p><h2>{p.title}</h2><p>{p.summary}</p></a>)}</div>
<nav class="project-pagination" aria-label={strings.paginationAria}><button type="button" data-page-step="-1" disabled>{strings.prevPage}</button><div class="project-page-numbers"></div><button type="button" data-page-step="1">{strings.nextPage}</button></nav>
<p class="catalog-empty" hidden>{strings.empty}</p><p class="media-note">{strings.mediaNote}</p>
</section>
<script is:inline type="application/json" data-catalog-strings set:html={JSON.stringify(clientStrings)}></script>
<script>
const csEl=document.querySelector('[data-catalog-strings]');
const cs=csEl?JSON.parse(csEl.textContent||'{}'):{all:'全部工程',countShort:'共 {n} 个项目',countFull:'共 {n} 个项目 · 第 {page} / {total} 页 · 本页 {from}–{to} 项'};
const fmt=(tpl:string,vars:Record<string,number>)=>String(tpl||'').replace(/\{(\w+)\}/g,(_,k)=>String(vars[k]??''));
const tabs=[...document.querySelectorAll<HTMLButtonElement>('[data-category]')];
const search=document.querySelector<HTMLInputElement>('.catalog-search input');
const cards=[...document.querySelectorAll<HTMLElement>('#project-results [data-categories]')];
const params=new URLSearchParams(window.location.search);
const requested=params.get('category');if(search)search.value=params.get('q')||'';
let category=tabs.some(t=>t.dataset.category===requested)?requested!:cs.all;
let page=1;
const pageSize=12;
const pagination=document.querySelector<HTMLElement>('.project-pagination');
const numbers=document.querySelector<HTMLElement>('.project-page-numbers');
const previous=document.querySelector<HTMLButtonElement>('[data-page-step="-1"]');
const next=document.querySelector<HTMLButtonElement>('[data-page-step="1"]');
function update(){
 document.querySelectorAll<HTMLElement>('[data-business-category]').forEach(panel=>panel.hidden=panel.dataset.businessCategory!==category);
 const term=(search?.value||'').trim().toLowerCase();
 const matches=cards.filter(card=>(category===cs.all||card.dataset.categories?.split('|').includes(category))&&(card.dataset.search||'').toLowerCase().includes(term));
 const totalPages=Math.ceil(matches.length/pageSize);
 page=Math.max(1,Math.min(page,totalPages||1));
 cards.forEach(card=>card.hidden=true);
 matches.slice((page-1)*pageSize,page*pageSize).forEach(card=>card.hidden=false);
 const label=document.querySelector('.catalog-count');
 if(label)label.textContent=matches.length?fmt(cs.countFull,{n:matches.length,page,total:totalPages,from:(page-1)*pageSize+1,to:Math.min(page*pageSize,matches.length)}):fmt(cs.countShort,{n:0});
 const empty=document.querySelector<HTMLElement>('.catalog-empty');if(empty)empty.hidden=matches.length>0;
 if(pagination)pagination.hidden=totalPages<=1;
 if(previous)previous.disabled=page===1;
 if(next)next.disabled=page>=totalPages;
 numbers?.replaceChildren();
 for(let n=1;n<=totalPages;n++){
  const button=document.createElement('button');button.type='button';button.textContent=String(n);button.dataset.page=String(n);button.setAttribute('aria-label',fmt(cs.pageAria||'第 {n} 页',{n}));
  if(n===page)button.setAttribute('aria-current','page');
  numbers?.append(button);
 }
}
function turnPage(value:number){page=value;update();document.querySelector('.catalog-count')?.scrollIntoView({block:'start'});numbers?.querySelector<HTMLButtonElement>(`[data-page="${page}"]`)?.focus({preventScroll:true});}
numbers?.addEventListener('click',event=>{const target=event.target;if(target instanceof HTMLButtonElement&&target.dataset.page)turnPage(Number(target.dataset.page));});
previous?.addEventListener('click',()=>turnPage(page-1));next?.addEventListener('click',()=>turnPage(page+1));
tabs.forEach(tab=>tab.addEventListener('click',()=>{category=tab.dataset.category||cs.all;page=1;tabs.forEach(t=>t.setAttribute('aria-pressed',String(t===tab)));update();}));
search?.addEventListener('input',()=>{page=1;update();});
tabs.forEach(t=>t.setAttribute('aria-pressed',String(t.dataset.category===category)));update();
</script>
