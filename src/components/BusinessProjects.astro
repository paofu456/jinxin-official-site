---

import ContentHeading from './ContentHeading.astro';
import projects from '../data/project-catalog.json';
import { getPublishedProducts } from '../lib/products';
import {business} from '../data/business';
const products=await getPublishedProducts();
const categories=['全部工程','超高层钢结构','大跨度空间结构','装配式建筑','城市运营建筑','钢结构住宅'];
---
<ContentHeading title="业务与案例" description="从超高层、大跨度空间到装配式建筑，查阅金鑫的业务方向与工程实践。" image="/media/products/long-span-space-steel-building.jpg" imageAlt="大跨度空间钢结构工程资料"><span class="heading-fact">{projects.length} 个工程项目 · 五类业务方向</span></ContentHeading>
<section class="wrap catalog-section">
<div class="catalog-tools"><div class="filter-tabs" role="group" aria-label="按业务方向筛选">{categories.map((c,i)=><button type="button" data-category={c} aria-pressed={i===0?'true':'false'}>{c}</button>)}</div><label class="catalog-search"><span>搜索项目</span><input type="search" placeholder="输入项目名称或关键词" aria-label="搜索工程案例"/></label></div>
<div class="integrated-business" aria-label="当前业务介绍">{products.map(p=><article data-business-category={business.find(b=>b.slug===p.data.slug)?.category} hidden><div><p class="eyebrow">业务方向</p><h2>{p.data.title}</h2><p>{p.data.summary}</p><a class="text-link" href={`/products/${p.data.slug}/`}>查阅完整业务资料</a></div><dl>{p.data.specifications.map(s=><div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}</dl></article>)}</div>
<p class="catalog-count" aria-live="polite">共 {projects.length} 个项目</p>
<div class="catalog-grid" id="project-results">{projects.map((p,i)=><a hidden={i>=12} class="catalog-card" href={p.path} data-categories={p.categories.join('|')} data-search={`${p.title} ${p.summary}`}><div class="catalog-image">{p.images[0]&&<img src={p.images[0].src} alt={p.title+'项目资料图片'} loading="lazy"/>}</div><p class="catalog-category">{p.categories.join(' · ')}</p><h2>{p.title}</h2><p>{p.summary}</p></a>)}</div>
<nav class="project-pagination" aria-label="工程案例分页"><button type="button" data-page-step="-1" disabled>上一页</button><div class="project-page-numbers"></div><button type="button" data-page-step="1">下一页</button></nav>
<p class="catalog-empty" hidden>没有找到匹配项目，请尝试其他关键词或业务方向。</p><p class="media-note">项目图片包含效果图；历史参数为项目整体资料，具体承包范围以合同约定为准。</p>
</section>
<script>
const tabs=[...document.querySelectorAll<HTMLButtonElement>('[data-category]')];
const search=document.querySelector<HTMLInputElement>('.catalog-search input');
const cards=[...document.querySelectorAll<HTMLElement>('#project-results [data-categories]')];
const params=new URLSearchParams(window.location.search);
const requested=params.get('category');if(search)search.value=params.get('q')||'';
let category=tabs.some(t=>t.dataset.category===requested)?requested!:'全部工程';
let page=1;
const pageSize=12;
const pagination=document.querySelector<HTMLElement>('.project-pagination');
const numbers=document.querySelector<HTMLElement>('.project-page-numbers');
const previous=document.querySelector<HTMLButtonElement>('[data-page-step="-1"]');
const next=document.querySelector<HTMLButtonElement>('[data-page-step="1"]');
function update(){
 document.querySelectorAll<HTMLElement>('[data-business-category]').forEach(panel=>panel.hidden=panel.dataset.businessCategory!==category);
 const term=(search?.value||'').trim().toLowerCase();
 const matches=cards.filter(card=>(category==='全部工程'||card.dataset.categories?.split('|').includes(category))&&(card.dataset.search||'').toLowerCase().includes(term));
 const totalPages=Math.ceil(matches.length/pageSize);
 page=Math.max(1,Math.min(page,totalPages||1));
 cards.forEach(card=>card.hidden=true);
 matches.slice((page-1)*pageSize,page*pageSize).forEach(card=>card.hidden=false);
 const label=document.querySelector('.catalog-count');
 if(label)label.textContent=matches.length?`共 ${matches.length} 个项目 · 第 ${page} / ${totalPages} 页 · 本页 ${(page-1)*pageSize+1}–${Math.min(page*pageSize,matches.length)} 项`:'共 0 个项目';
 const empty=document.querySelector<HTMLElement>('.catalog-empty');if(empty)empty.hidden=matches.length>0;
 if(pagination)pagination.hidden=totalPages<=1;
 if(previous)previous.disabled=page===1;
 if(next)next.disabled=page>=totalPages;
 numbers?.replaceChildren();
 for(let n=1;n<=totalPages;n++){
  const button=document.createElement('button');button.type='button';button.textContent=String(n);button.dataset.page=String(n);button.setAttribute('aria-label',`第 ${n} 页`);
  if(n===page)button.setAttribute('aria-current','page');
  numbers?.append(button);
 }
}
function turnPage(value:number){page=value;update();document.querySelector('.catalog-count')?.scrollIntoView({block:'start'});numbers?.querySelector<HTMLButtonElement>(`[data-page="${page}"]`)?.focus({preventScroll:true});}
numbers?.addEventListener('click',event=>{const target=event.target;if(target instanceof HTMLButtonElement&&target.dataset.page)turnPage(Number(target.dataset.page));});
previous?.addEventListener('click',()=>turnPage(page-1));next?.addEventListener('click',()=>turnPage(page+1));
tabs.forEach(tab=>tab.addEventListener('click',()=>{category=tab.dataset.category||'全部工程';page=1;tabs.forEach(t=>t.setAttribute('aria-pressed',String(t===tab)));update();}));
search?.addEventListener('input',()=>{page=1;update();});
tabs.forEach(t=>t.setAttribute('aria-pressed',String(t.dataset.category===category)));update();
</script>
