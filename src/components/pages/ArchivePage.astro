---
import CompanyContact from '../CompanyContact.astro';
import Layout from '../../layouts/Layout.astro';
import archive from '../../data/archive.json';
import archiveEn from '../../data/archive-en.json';
import { getProjectCatalog, getNewsCatalog, localizeArchiveHtml, type LocalizedProject } from '../../lib/catalog';
import ProjectDetail from '../project/ProjectDetail.astro';
import CorporateRecord from '../records/CorporateRecord.astro';
import NewsRecord from '../records/NewsRecord.astro';
import { getCompany, t, toLocalePath, type Locale } from '../../i18n/ui';
interface Props {page:typeof archive[number]; lang?: Locale;}
const {page, lang='zh'}=Astro.props;
const company=getCompany(lang);
const strings=t(lang).archive;
// Later entries also localize legacy paginated listing URLs.
const override=lang==='en'?archiveEn.find(p=>p.path===page.path):undefined;
const project:LocalizedProject|undefined=getProjectCatalog(lang).find(p=>p.path===page.path);
const news=getNewsCatalog(lang).find(p=>p.path===page.path);
const localized=project??news;
const untranslated=lang==='en'&&!override&&!localized;
const record=lang==='en'&&localized?{...page,title:localized.title,text:localized.summary,html:localized.bodyHtml}:override??page;
const corporate=['/page/gsjs.html','/page/fzlc.html','/page/zpsgjgqbjztx.html'].includes(page.path)||/^\/(article\/(zzzs|gsry)|download\/jszl)(\/|\.html)/.test(page.path);
const isContact=page.path==='/page/lxwm.html';
const category=page.kind==='project'?strings.projectCategory:page.kind==='news'?strings.newsCategory:page.path.includes('jszl')||page.path.includes('zpsgjgqbjztx')?strings.techCategory:page.submenu.some(p=>p.label==='公司介绍'||p.label==='Company Profile')?strings.aboutCategory:record.title;
const alternate=lang==='en'?page.path:toLocalePath('en',page.path);
const description=(record.text||'').trim().slice(0,150)||`${record.title} — ${company.description}`;
const submenu=lang==='en'?record.submenu.map(item=>({...item,href:/^\/(article|page|download)\//.test(item.href)?'/en'+item.href:item.href})):record.submenu;
const contentHtml=localizeArchiveHtml(record.html,lang);
---
<Layout title={record.title} description={description} showInquiry={false} lang={lang} alternate={alternate}>
{untranslated&&<div class="wrap" style="padding-top:24px"><aside class="record-note" lang="en">{strings.zhOnlyNote}</aside></div>}
{isContact?<CompanyContact lang={lang}/>:project?<ProjectDetail project={project} lang={lang}/>:corporate?<CorporateRecord page={record} lang={lang}/>:page.kind==='news'?<NewsRecord page={record} lang={lang}/>:<>
<section class={'page-heading '+(page.kind==='project'?'project-heading':'')}><div class="wrap"><div class="breadcrumbs"><a href={toLocalePath(lang,'/')}>{strings.breadcrumbHome}</a><span>/</span><span>{category}</span></div><h1>{record.title}</h1><p>{page.kind==='project'?strings.projectHeadingText:page.kind==='news'?strings.newsHeadingText:strings.defaultHeadingText}</p></div></section>
{submenu.length>0&&<div class="subnav"><nav class="wrap" aria-label={t(lang).records.subnavAria}>{submenu.map(item=><a href={item.href} class={item.href===page.path?'active':''}>{item.label}</a>)}</nav></div>}
<div class="wrap archive-wrap">

{page.kind==='project'&&<aside class="record-note">{strings.projectNote}</aside>}
<article class={'archive-content '+page.kind} set:html={contentHtml}/>
{page.kind==='project'&&<div class="detail-consult"><div><h2>{strings.consultHeading}</h2></div><a class="button green" href={toLocalePath(lang,'/page/lxwm.html')}>{strings.consultCta}</a></div>}

</div>
</>}
<script is:inline type="application/json" data-archive-strings set:html={JSON.stringify({close:strings.closeDialog,closeAria:strings.closeDialogAria,zoomPrefix:strings.zoomAriaPrefix})}></script>
<script>
const asEl=document.querySelector('[data-archive-strings]');
const archiveStrings=asEl?JSON.parse(asEl.textContent||'{}'):{close:'关闭 ×',closeAria:'关闭图片预览',zoomPrefix:'放大查看'};
 const article=document.querySelector('.archive-content');
 function showImage(img:HTMLImageElement){const dialog=document.createElement('dialog');dialog.className='image-dialog';const close=document.createElement('button');close.textContent=archiveStrings.close;close.setAttribute('aria-label',archiveStrings.closeAria);dialog.append(close,img.cloneNode(true));document.body.append(dialog);close.addEventListener('click',()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close();});dialog.addEventListener('close',()=>dialog.remove());dialog.showModal();close.focus();}
 article?.querySelectorAll('img').forEach(img=>{const link=img.closest('a');if(link){if(link.classList.contains('lightbox'))link.addEventListener('click',e=>{e.preventDefault();showImage(img);});return;}const button=document.createElement('button');button.type='button';button.className='image-zoom';button.setAttribute('aria-label',archiveStrings.zoomPrefix+img.alt);img.replaceWith(button);button.append(img);button.addEventListener('click',()=>showImage(img));});
</script>
</Layout>
