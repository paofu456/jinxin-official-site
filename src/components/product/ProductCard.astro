---
import type { CollectionEntry } from "astro:content";

interface Props { product: CollectionEntry<"products">; }
const { product } = Astro.props;
const image = product.data.images[0];
---

<article class="group overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white transition duration-300 hover:-translate-y-1 hover:shadow-[var(--shadow-card)]">
  <a href={`/products/${product.data.slug}/`} class="relative block overflow-hidden bg-[#e8eef9]">
    <span class="absolute left-4 top-4 z-10 rounded-lg bg-white px-3 py-2 text-[10px] font-extrabold tracking-[.12em] text-[var(--color-primary)]">业务 {String(product.data.order).padStart(2, "0")}</span>
    <img src={image.src} alt={image.alt} width="800" height="620" loading="lazy" class="aspect-[4/3] h-auto w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
  </a>
  <div class="p-7">
    <h3 class="text-2xl font-extrabold"><a href={`/products/${product.data.slug}/`} class="hover:text-[var(--color-primary)]">{product.data.title}</a></h3>
    <p class="mt-3 text-sm leading-7 text-[var(--color-muted)]">{product.data.summary}</p>
    <a href={`/products/${product.data.slug}/`} class="mt-6 inline-flex items-center gap-2 text-sm font-extrabold text-[var(--color-primary)]">查看业务 </a>
  </div>
</article>
