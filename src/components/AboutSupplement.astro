---
import ContactCta from "../components/sections/ContactCta.astro";
import Container from "../components/ui/Container.astro";
import company from "../data/company.json";



const milestones = [
  { year: "1998", text: "公司前身「深圳市信联佳实业发展有限公司」成立。" },
  { year: "2001", text: "在深圳市龙华美景工业区设置公司第一个工厂。" },
  { year: "2004", text: "企业更名为「深圳市金鑫钢结构建筑安装工程有限公司」，在深圳市龙岗区坪地街道年丰社区投资建厂。" },
  { year: "2010", text: "企业总部乔迁至深圳市福田区泰然九路盛唐大厦。" },
  { year: "2015", text: "完成股份改制，企业更名为「深圳金鑫绿建股份有限公司」。" },
  { year: "2016", text: "在全国中小企业股份转让系统挂牌，股票代码 839696。" },
  { year: "2017", text: "推进装配式钢结构绿色建筑体系在项目中的应用。" },
  { year: "2018", text: "装配式钢结构轻板建筑体系通过由中国建筑金属结构协会组织、周绪红院士任组长的国家级专家组技术鉴定。" },
  { year: "2019", text: "库马克大厦被认定为广东省首批装配式建筑示范项目。" },
];
---

<div class="about-supplement">
  <section class="border-b border-[var(--color-line)] bg-white py-20 sm:py-28">
    <Container>
      <p class="eyebrow mb-5">关于金鑫</p>
      <h2 class="max-w-5xl text-4xl font-extrabold leading-[1.12] sm:text-6xl">{company.name}</h2>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-[var(--color-muted)]">{company.tagline}</p>
    </Container>
  </section>

  <section class="py-24 sm:py-32">
    <Container class="grid items-start gap-14 lg:grid-cols-2 lg:gap-20">
      <img src="/media/projects/shenzhen-bay-one-01.jpg" alt="深圳湾壹号超高层塔楼建筑外观" width="1280" height="847" class="w-full rounded-[var(--radius-card)] shadow-[var(--shadow-card)]" />
      <div>
        <p class="eyebrow mb-4">公司简介</p>
        <h2 class="text-3xl font-extrabold leading-tight sm:text-4xl">以钢结构工程建造为主业</h2>
        <div class="prose-site mt-7">
          <p>{company.description}</p>
          <p>公司总部位于深圳市龙岗区，在钢结构建筑领域具有设计、制造和施工经验，形成了以专业化设计、工厂化制造、标准化安装为特点的业务体系。</p>
        </div>
        <dl class="mt-9 grid gap-5 sm:grid-cols-2">
          <div class="rounded-2xl border border-[var(--color-line)] bg-white p-6">
            <dt class="text-xs font-bold tracking-[0.08em] text-[var(--color-muted)]">成立年份</dt>
            <dd class="mt-2 text-lg font-extrabold">{company.founded}</dd>
          </div>
          <div class="rounded-2xl border border-[var(--color-line)] bg-white p-6">
            <dt class="text-xs font-bold tracking-[0.08em] text-[var(--color-muted)]">总部所在地</dt>
            <dd class="mt-2 text-lg font-extrabold">{company.location}</dd>
          </div>
        </dl>
      </div>
    </Container>
  </section>

  <section class="bg-white py-24 sm:py-32">
    <Container>
      <p class="eyebrow mb-4">发展历程</p>
      <h2 class="max-w-3xl text-3xl font-extrabold leading-tight sm:text-4xl">从钢结构制作安装起步，到装配式钢结构建筑体系</h2>
      <ol class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {milestones.map((milestone) => (
          <li class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-[var(--color-surface)] p-6">
            <p class="text-sm font-extrabold text-[var(--color-primary)]">{milestone.year}</p>
            <p class="mt-3 text-sm leading-7 text-[var(--color-muted)]">{milestone.text}</p>
          </li>
        ))}
      </ol>
    </Container>
  </section>

  <section class="py-24 sm:py-32">
    <Container class="grid items-start gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow mb-4">技术体系</p>
        <h2 class="text-3xl font-extrabold leading-tight sm:text-4xl">装配式钢结构轻板建筑体系</h2>
        <div class="prose-site mt-7">
          <p>体系以钢结构主体（Steel-structure）、轻板围护系统（Light-weight cladding system）及装配式建筑技术（Assembled building technology）为核心理念，按照标准化设计、工厂化制作、装配化施工、信息化管理组织建造。</p>
          <p>该体系由公司与国内外技术成果结合研发，并与中国建筑科学研究院、清华大学、重庆大学等科研院校开展合作，已应用在库马克大厦、龙岗区第四人民医院过渡业务用房等项目中。</p>
        </div>
        <a href="/products/prefabricated-steel-building/" class="mt-8 inline-flex min-h-12 items-center rounded-full bg-[var(--color-primary)] px-6 py-3 text-sm font-bold text-white hover:bg-[var(--color-primary-dark)]">查看装配式钢结构业务</a>
      </div>
      <img src="/media/products/prefabricated-steel-building.jpg" alt="装配式钢结构高层建筑外立面" width="1440" height="1080" class="w-full rounded-[var(--radius-card)] shadow-[var(--shadow-card)]" />
    </Container>
  </section>

  <section class="pb-24"><Container><div class="resource-links"><h2>企业资料</h2><p>了解公司完整介绍、发展历程、资质荣誉与技术成果。</p><nav aria-label="企业资料"><a href="/page/gsjs.html">完整公司介绍</a><a href="/page/fzlc.html">发展历程</a><a href="/article/zzzs.html">资质证书</a><a href="/article/gsry.html">公司荣誉</a><a href="/download/jszl.html">技术专利</a></nav></div></Container></section>
  <ContactCta />
</div>

