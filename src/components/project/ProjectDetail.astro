---
import catalog from '../../data/project-catalog.json';
import archive from '../../data/archive.json';
interface Props { project: typeof catalog[number]; }
const { project } = Astro.props;
const original = archive.find(p=>p.path===project.path);
---
<section class="detail-heading wrap">
<nav class="breadcrumbs" aria-label="当前位置"><a href="/">首页</a><span>/</span><a href="/projects/">业务与案例</a></nav>
<p class="eyebrow">{project.categories.join(' · ')}</p><h1>{project.title}</h1><p class="detail-intro">{project.summary}</p>
</section>
{project.images[0]&&<figure class="project-cover wrap"><img src={project.images[0].src} alt={project.images[0].alt} fetchpriority="high"/><figcaption>项目资料图片，包含效果图。</figcaption></figure>}
<section class="wrap project-information">
<div><p class="eyebrow">项目概况与结构特点</p><article class="prose-site project-body" set:html={project.bodyHtml}/><slot/></div>
<aside><h2>工程资料</h2><dl class="parameter-list"><div><dt>业务方向</dt><dd>{project.categories.join(' / ')}</dd></div>{project.specifications.map(s=><div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}</dl><p class="media-note">参数来自历史项目资料；具体承包范围以合同约定为准。</p><a class="button green" href="/contact/">咨询同类工程</a></aside>
</section>
{project.images.length>1&&<section class="wrap project-gallery"><div class="section-heading"><h2>工程影像</h2><p>建筑外观、结构与施工记录</p></div><div>{project.images.slice(1).map((img,i)=><figure><button class="catalog-zoom" type="button" aria-label={`放大查看${project.title}第${i+2}张图片`}><img src={img.src} alt={img.alt} loading="lazy"/></button><figcaption>{project.title} / 项目图片 {String(i+2).padStart(2,'0')}</figcaption></figure>)}</div></section>}
{project.related.length>0&&<section class="wrap related-projects"><div class="section-heading"><h2>相关工程</h2><a class="text-link" href="/projects/">全部工程案例</a></div><div class="catalog-grid">{project.related.filter(p=>p.href!==project.path).map(p=><a class="catalog-card" href={p.href}>{p.image&&<img src={p.image} alt={p.title} loading="lazy"/>}<h3>{p.title}</h3><p>{p.summary}</p></a>)}</div></section>}
{original&&<div class="wrap complete-record"><details><summary>查阅完整项目记录</summary><article class="archive-content project" set:html={original.html}/></details></div>}
<script>
document.querySelectorAll<HTMLButtonElement>('.catalog-zoom').forEach(button=>button.addEventListener('click',()=>{
 const img=button.querySelector('img');if(!img)return;const dialog=document.createElement('dialog');dialog.className='image-dialog';
 const close=document.createElement('button');close.type='button';close.textContent='关闭';dialog.append(close,img.cloneNode(true));document.body.append(dialog);
 close.addEventListener('click',()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close();});dialog.addEventListener('close',()=>{dialog.remove();button.focus();});dialog.showModal();close.focus();
}));
</script>
