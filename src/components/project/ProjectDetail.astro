---
import catalog from '../../data/project-catalog.json';
import archive from '../../data/archive.json';
import { localizeArchiveHtml } from '../../lib/catalog';
import { t, toLocalePath, type Locale } from '../../i18n/ui';
interface Props { project: typeof catalog[number]; lang?: Locale; }
const { project, lang='zh' } = Astro.props;
const strings=t(lang).project;
const original=lang==='zh'?archive.find(p=>p.path===project.path):undefined;
// Keep project illustrations inline; image-only links should not open raw files.
const inlineImages=(html:string)=>html.replace(/<a\b[^>]*>\s*(<img\b[^>]*\/?>)\s*<\/a>/gi,'$1');
const bodyHtml=localizeArchiveHtml(inlineImages(project.bodyHtml),lang);
const relatedHref=(href:string)=>lang==='en'&&/^\/(article|page|download)\//.test(href)?'/en'+href:href;
---
<section class="detail-heading wrap">
<nav class="breadcrumbs" aria-label={t(lang).breadcrumb.aria}><a href={toLocalePath(lang,'/')}>{t(lang).breadcrumb.home}</a><span>/</span><a href={toLocalePath(lang,'/projects/')}>{strings.breadcrumbSection}</a></nav>
<p class="eyebrow">{project.categories.join(' · ')}</p><h1>{project.title}</h1><p class="detail-intro">{project.summary}</p>
</section>
{project.images[0]&&<figure class="project-cover wrap"><div class="project-cover-image"><img src={project.images[0].src} alt={project.images[0].alt} fetchpriority="high"/></div><figcaption>{strings.coverCaption}</figcaption></figure>}
<section class="wrap project-information">
<div><p class="eyebrow">{strings.overviewEyebrow}</p><article class="prose-site project-body" set:html={bodyHtml}/><slot/></div>
<aside><h2>{strings.infoHeading}</h2><dl class="parameter-list"><div><dt>{strings.categoryLabel}</dt><dd>{project.categories.join(' / ')}</dd></div>{project.specifications.map(s=><div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}</dl><p class="media-note">{strings.specNote}</p><a class="button green" href={toLocalePath(lang,'/contact/')}>{strings.consultCta}</a></aside>
</section>
{project.images.length>1&&<section class="wrap project-gallery"><div class="section-heading"><h2>{strings.galleryHeading}</h2><p>{strings.galleryNote}</p></div><div>{project.images.slice(1).map((img,i)=><figure><div class="project-gallery-image"><img src={img.src} alt={img.alt} loading="lazy"/></div><figcaption>{strings.galleryCaption(project.title,String(i+2).padStart(2,'0'))}</figcaption></figure>)}</div></section>}
{project.related.length>0&&<section class="wrap related-projects"><div class="section-heading"><h2>{strings.relatedHeading}</h2><a class="text-link" href={toLocalePath(lang,'/projects/')}>{strings.allProjects}</a></div><div class="catalog-grid">{project.related.filter(p=>p.href!==project.path).map(p=><a class="catalog-card" href={relatedHref(p.href)}>{p.image&&<img src={p.image} alt={p.title} loading="lazy"/>}<h3>{p.title}</h3><p>{p.summary}</p></a>)}</div></section>}
{original&&<div class="wrap complete-record"><details><summary>{strings.fullRecord}</summary><article class="archive-content project" set:html={inlineImages(original.html)}/></details></div>}
