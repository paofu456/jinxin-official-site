---
import type { CollectionEntry } from "astro:content";

interface Props { project: CollectionEntry<"projects">; }
const { project } = Astro.props;
const image = project.data.images[0];
---

<article class="group overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white transition duration-300 hover:-translate-y-1 hover:shadow-[var(--shadow-card)]">
  <a href={`/projects/${project.data.slug}/`} class="relative block overflow-hidden bg-[#e7edf2]">
    <span class="absolute left-4 top-4 z-10 rounded-lg bg-white/95 px-3 py-2 text-[10px] font-extrabold tracking-[.08em] text-[var(--color-primary)]">{project.data.category}</span>
    <img src={image.src} alt={image.alt} width="800" height="620" loading="lazy" class="aspect-[4/3] h-auto w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
  </a>
  <div class="p-7">
    <h3 class="text-2xl font-extrabold"><a href={`/projects/${project.data.slug}/`} class="hover:text-[var(--color-primary)]">{project.data.title}</a></h3>
    <p class="mt-3 text-sm leading-7 text-[var(--color-muted)]">{project.data.summary}</p>
    <a href={`/projects/${project.data.slug}/`} class="mt-6 inline-flex items-center gap-2 text-sm font-extrabold text-[var(--color-primary)]">查看案例 </a>
  </div>
</article>
