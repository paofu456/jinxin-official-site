---
import { siteConfig } from '../../site.config';
import archive from '../data/archive.json';
import { alternateLocalePath, getCompany, t, toLocalePath, type Locale } from '../i18n/ui';
interface Props { home?: boolean; lang?: Locale; alternate?: string; }
const {home=false, lang='zh', alternate}=Astro.props;
const company=getCompany(lang);
const strings=t(lang);
const rawPath=Astro.url.pathname;
const path=lang==='en'?(rawPath.slice(3)||'/'):rawPath;
const kind=archive.find(record=>record.path===path)?.kind;
const activeZh=kind==='news'||path.startsWith('/news')?'/news/':kind==='project'||path.startsWith('/products')||path.startsWith('/projects')||/^\/article\/(gjg|mkhgjg|zpsjz|zpsgjgcsyycp|gjgxcbscp)/.test(path)?'/projects/':path.includes('zpsgjgqbjztx')||path.includes('/download/')?'/page/zpsgjgqbjztx.html':path.startsWith('/about')||path.startsWith('/contact')||/^\/(page\/(gsjs|fzlc|lxwm)|article\/(zzzs|gsry))/.test(path)?'/about/':path;
const active=lang==='en'?toLocalePath('en',activeZh):activeZh;
const dropdowns:Record<string,{image:string;links:{label:string;href:string}[]}>= lang==='en'?{
 '/en/about/':{image:'/media/a33a0f4a8d4273f7.jpg',links:[{label:'Company Profile',href:'/en/about/'},{label:'Development Path',href:'/en/page/fzlc.html'},{label:'Honor',href:'/en/article/gsry.html'},{label:'Certifications',href:'/en/article/zzzs.html'},{label:'Contact Us',href:'/en/contact/'}]},
 '/en/projects/':{image:'/media/50057c6a05191288.jpg',links:[{label:'Super High-Rise Steel Structure',href:'/en/projects/?category=Super High-Rise Steel Structure'},{label:'Large-Span Space Steel Structure',href:'/en/projects/?category=Large-Span Space Steel Structure'},{label:'Assembled Steel Structure',href:'/en/projects/?category=Assembled Steel Structure'},{label:'Urban Operation Building',href:'/en/projects/?category=Urban Operation Building'},{label:'Steel Structure Residence',href:'/en/projects/?category=Steel Structure Residence'}]},
 '/en/page/zpsgjgqbjztx.html':{image:'/media/d8de2ae9fec16e1a.png',links:[{label:'Assembled Steel Structure Light Panel Building System',href:'/en/page/zpsgjgqbjztx.html'},{label:'Technology Patents',href:'/en/download/jszl.html'}]},
 '/en/news/':{image:'/media/24f936e5490e70b1.jpg',links:[{label:'Company News',href:'/en/news/'}]},
}:{
 '/about/':{image:'/media/a33a0f4a8d4273f7.jpg',links:[{label:'公司介绍',href:'/about/'},{label:'发展历程',href:'/page/fzlc.html'},{label:'公司荣誉',href:'/article/gsry.html'},{label:'资质证书',href:'/article/zzzs.html'},{label:'联系我们',href:'/contact/'}]},
 '/projects/':{image:'/media/50057c6a05191288.jpg',links:[{label:'超高层钢结构建筑',href:'/projects/?category=超高层钢结构'},{label:'大跨度空间钢结构建筑',href:'/projects/?category=大跨度空间结构'},{label:'装配式钢结构建筑',href:'/projects/?category=装配式建筑'},{label:'城市运营建筑产品',href:'/projects/?category=城市运营建筑'},{label:'钢结构住宅',href:'/projects/?category=钢结构住宅'}]},
 '/page/zpsgjgqbjztx.html':{image:'/media/d8de2ae9fec16e1a.png',links:[{label:'装配式钢结构轻板建筑体系',href:'/page/zpsgjgqbjztx.html'},{label:'技术专利',href:'/download/jszl.html'}]},
 '/news/':{image:'/media/24f936e5490e70b1.jpg',links:[{label:'企业动态',href:'/news/'}]},
};
const navigation=lang==='en'?siteConfig.navigationEn:siteConfig.navigation;
const nav=navigation.filter(item=>item.href!==toLocalePath(lang,'/contact/'));
const switchHref=alternateLocalePath(rawPath,alternate);
---
<header class="gsin-header" data-site-header>
 <div class="gsin-header-inner">
  <a class="gsin-logo" href={toLocalePath(lang,'/')} aria-label={strings.header.logoAria}><img src="/media/aa610ace6fdd23b1.png" alt="GSIN 金鑫绿建" width="136" height="40"/></a>
  <button class="gsin-menu-button" type="button" aria-expanded="false" aria-controls="gsin-navigation">{strings.header.menu}</button>
  <nav class="gsin-navigation" id="gsin-navigation" aria-label={strings.header.navAria}>{nav.map(item=><div class="gsin-nav-item"><a class="gsin-category" href={item.href} aria-current={active===item.href?'page':undefined}>{item.label}</a>{dropdowns[item.href]&&<div class="gsin-dropdown"><img src={dropdowns[item.href].image} alt="" aria-hidden="true" width="166" height="117"/><div>{dropdowns[item.href].links.map(link=><a href={link.href}>{link.label}</a>)}</div></div>}</div>)}</nav>
  <div class="gsin-search"><button class="gsin-search-toggle" type="button" aria-label={strings.header.searchAria} aria-expanded="false" aria-controls="gsin-search-form"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="5.5"/><path d="m15 15 5 5"/></svg></button><form id="gsin-search-form" class="gsin-search-form" role="search" action={toLocalePath(lang,'/projects/')} hidden><input type="search" name="q" aria-label={strings.header.searchPlaceholder} placeholder={strings.header.searchPlaceholder} required/><button type="submit">{strings.header.searchSubmit}</button></form></div>
  <a class="gsin-lang-switch" href={switchHref} aria-label={strings.header.switchAria} hreflang={lang==='en'?'zh-CN':'en'}>{strings.header.switchLabel}</a>
 </div>
</header>
{!home&&<div class="gsin-header-space" aria-hidden="true"></div>}
<script>
 import { business } from '../data/business';
 const header=document.querySelector<HTMLElement>('[data-site-header]');
 const languageSwitch=header?.querySelector<HTMLAnchorElement>('.gsin-lang-switch');
 const alternatePath=languageSwitch?.getAttribute('href');
 function syncLanguageSwitch(){
  if(!languageSwitch||!alternatePath)return;
  const target=new URL(alternatePath,window.location.origin);
  target.search=window.location.search;
  const category=target.searchParams.get('category');
  const item=business.find(item=>item.category===category||item.en.category===category);
  if(item)target.searchParams.set('category',target.pathname.startsWith('/en/')?item.en.category:item.category);
  languageSwitch.href=target.pathname+target.search+window.location.hash;
 }
 syncLanguageSwitch();
 document.addEventListener('catalog-state-change',syncLanguageSwitch);
 window.addEventListener('popstate',syncLanguageSwitch);
 const menu=header?.querySelector<HTMLButtonElement>('.gsin-menu-button');
 const search=header?.querySelector<HTMLButtonElement>('.gsin-search-toggle');
 const form=header?.querySelector<HTMLFormElement>('.gsin-search-form');
 function closeSearch(){if(form)form.hidden=true;search?.setAttribute('aria-expanded','false');}
 menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));header?.classList.toggle('menu-open',open);});
 search?.addEventListener('click',()=>{if(!form)return;const open=form.hidden;form.hidden=!open;search.setAttribute('aria-expanded',String(open));if(open)form.querySelector('input')?.focus();});
 document.addEventListener('click',event=>{if(event.target instanceof Node&&!header?.contains(event.target))closeSearch();});
 header?.addEventListener('keydown',event=>{if(event.key==='Escape'){closeSearch();header.classList.remove('menu-open');menu?.setAttribute('aria-expanded','false');if(event.target instanceof HTMLElement&&event.target.closest('.gsin-search'))search?.focus();}});
</script>
<style>
 .gsin-header,.gsin-header *{box-sizing:border-box}.gsin-header{position:fixed;top:0;left:0;width:100%;height:100px;z-index:500;background:#fff;box-shadow:0 2px 19px #00000017;font-family:"Microsoft YaHei","PingFang SC",Arial,sans-serif;font-weight:400;line-height:1.5;color:#383735;letter-spacing:0}.gsin-header-inner{width:calc(100% - 40px);max-width:1400px;height:100%;margin:0 auto;position:relative;display:flex;align-items:center;justify-content:space-between}.gsin-header a{text-decoration:none}.gsin-logo{position:relative;z-index:2;flex:0 0 136px;display:block;width:136px;height:40px}.gsin-logo img{display:block;width:136px;height:40px;max-width:none}.gsin-navigation{position:absolute;inset:0;display:flex;align-items:stretch;justify-content:center;gap:40px;pointer-events:none}.gsin-nav-item{position:relative;pointer-events:auto}.gsin-category{display:flex;align-items:center;justify-content:center;height:100px;padding:0 17px;font-size:16px;color:#383735;white-space:nowrap;transition:background .2s,color .2s}.gsin-category[aria-current=page],.gsin-nav-item:hover>.gsin-category{background:#32b372;color:#fff}.gsin-dropdown{position:absolute;left:50%;top:100%;transform:translateX(-50%);width:450px;padding:22px;display:grid;grid-template-columns:166px minmax(0,1fr);gap:26px;background:#fff;box-shadow:0 13px 42px #00000017;visibility:hidden;opacity:0;transition:opacity .2s,visibility .2s}.gsin-nav-item:hover>.gsin-dropdown,.gsin-nav-item:focus-within>.gsin-dropdown{visibility:visible;opacity:1}.gsin-dropdown>img{display:block;width:166px;height:117px;object-fit:cover}.gsin-dropdown>div{border-left:1px solid #dcdcdc;padding-left:22px}.gsin-dropdown a{display:block;font-size:14px;font-weight:400;color:#666;padding:7px 0;line-height:1.6}.gsin-dropdown a:hover{color:#248957}.gsin-search{position:relative;z-index:3;margin-left:auto}.gsin-search-toggle{width:40px;height:100px;display:flex;align-items:center;justify-content:center;padding:0;border:0;background:transparent;color:#888;cursor:pointer}.gsin-search-toggle:hover{color:#248957}.gsin-search-form{position:absolute;right:0;top:100%;width:320px;height:44px;display:flex;margin:0;box-shadow:0 5px 18px #0002}.gsin-search-form[hidden]{display:none}.gsin-search-form input{width:260px;min-width:0;border:0;border-radius:0;background:#333;color:#fff;font-size:14px;line-height:1.5;padding:0 15px;font-family:inherit}.gsin-search-form input::placeholder{color:#ddd}.gsin-search-form>button{width:60px;border:0;border-radius:0;background:#32b372;color:#fff;font:inherit;font-size:14px;cursor:pointer}.gsin-lang-switch{position:relative;z-index:3;display:flex;align-items:center;justify-content:center;min-width:40px;height:28px;margin-left:8px;padding:0 8px;border:1px solid #dce3e5;font-size:13px;color:#666}.gsin-lang-switch:hover{color:#248957;border-color:#248957}.gsin-menu-button{display:none}.gsin-header :is(a,button,input):focus-visible{outline:2px solid #16744f;outline-offset:-3px}.gsin-header-space{height:100px}
 @media(max-width:1100px){.gsin-navigation{gap:16px}.gsin-category{padding:0 13px}}
 @media(max-width:800px){.gsin-header,.gsin-header-space{height:74px}.gsin-logo,.gsin-logo img{width:115px;height:auto}.gsin-logo{flex-basis:115px}.gsin-menu-button{display:block;margin-left:auto;margin-right:14px;border:1px solid #dce3e5;background:#fff;color:#383735;padding:9px 13px;font-family:inherit;font-size:14px;cursor:pointer}.gsin-navigation{inset:74px -20px auto;display:none;max-height:calc(100svh - 74px);overflow:auto;background:#fff;padding:10px 20px 20px;pointer-events:auto}.menu-open .gsin-navigation{display:block}.gsin-category{height:48px;justify-content:flex-start;padding:0 15px}.gsin-dropdown{display:none;position:static;visibility:visible;opacity:1;transform:none;width:auto;box-shadow:none;padding:5px 15px 16px}.gsin-dropdown>img{display:none}.menu-open .gsin-dropdown{display:block}.gsin-dropdown>div{border-left:1px solid #dcdcdc;padding-left:16px}.gsin-search{margin-left:0}.gsin-search-toggle{height:74px}.gsin-search-form{max-width:calc(100vw - 40px)}}
 @media(prefers-reduced-motion:reduce){.gsin-header *{transition:none}}
</style>
