---
import '../styles/global.css';
import '../styles/site.css';
import '../styles/content-design.css';
import SeoHead from '../components/SeoHead.astro';
import { getCompany, localeMeta, t, toLocalePath, type Locale } from '../i18n/ui';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title: string; description?: string; image?: string; noindex?: boolean; showInquiry?: boolean; lang?: Locale; alternate?: string; }
const { title, description, image, noindex, showInquiry=true, lang='zh', alternate }=Astro.props;
const company=getCompany(lang);
const strings=t(lang);
const meta=localeMeta[lang];
---
<!doctype html>
<html lang={meta.htmlLang}>
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><SeoHead title={title} description={description??company.description} image={image} noindex={noindex} lang={lang}/></head>
<body>
<a href="#main-content" class="skip">{strings.skip}</a>
<SiteHeader lang={lang} alternate={alternate}/>
<main id="main-content"><slot/></main>
{showInquiry&&<section class="inquiry"><div class="wrap inquiry-inner"><div><p class="eyebrow light">LET’S BUILD TOGETHER</p><h2>{strings.inquiry.headingLines[0]}<br/>{strings.inquiry.headingLines[1]}</h2><p>{strings.inquiry.text}</p></div><a class="button cream" href={toLocalePath(lang,'/contact/')}>{strings.inquiry.cta} </a></div></section>}
<SiteFooter lang={lang}/>
</body></html>
