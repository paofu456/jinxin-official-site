---
import Button from "../components/ui/Button.astro";
import Container from "../components/ui/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { makePageTitle } from "../lib/seo";
---

<BaseLayout
  title={makePageTitle("页面未找到")}
  description="您访问的页面不存在或已被移动，可以返回首页，或浏览钢结构业务与工程案例。"
  noindex={true}
>
  <section class="py-28 sm:py-40">
    <Container class="text-center">
      <p class="text-8xl font-extrabold text-[var(--color-primary)] sm:text-9xl">404</p>
      <h1 class="mt-6 text-4xl font-extrabold sm:text-6xl">您访问的页面不存在</h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-[var(--color-muted)]">链接可能已变更，或该页面已经不存在。</p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <Button href="/">返回首页</Button>
        <Button href="/projects/" variant="secondary">浏览工程案例</Button>
      </div>
    </Container>
  </section>
</BaseLayout>
