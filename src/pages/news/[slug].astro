---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatNewsDate, getNewsHref, getPublishedNews, splitNewsTitle } from "../../lib/news";
import { makePageTitle } from "../../lib/seo";
import catalog from "../../data/news-catalog.json";
import archive from "../../data/archive.json";
import NewsRecord from "../../components/records/NewsRecord.astro";

type NewsItem = CollectionEntry<"news">;

export async function getStaticPaths() {
  const news = await getPublishedNews();
  return news.map((item, index) => ({
    params: { slug: item.data.slug },
    props: {
      item,
      related: news.filter((_, entryIndex) => entryIndex !== index).slice(0, 3),
    },
  }));
}

interface Props {
  item: NewsItem;
  related: NewsItem[];
}

const { item, related } = Astro.props;
const { Content } = await render(item);
const { tag, display } = splitNewsTitle(item.data.title);
const label = tag || item.data.category;
const hasBody = (item.body ?? "").trim().length > 0;
const normalizeTitle = (title: string) => title.replace(/[\s\p{P}\p{S}]/gu, '').toLowerCase();
const sourceAliases: Record<string, string> = {
  'metro-line-8-depot-steel-topping': '/article/detail/288.html',
  'guangzhou-yihai-warehouse-topping': '/article/detail/281.html',
};
const original = catalog.find(entry => entry.path === sourceAliases[item.data.slug] || normalizeTitle(entry.title) === normalizeTitle(item.data.title));
const originalPage = archive.find(page => page.path === original?.path);
---

<BaseLayout
  title={makePageTitle(display)}
  description={item.data.summary || `${display}——深圳金鑫绿建股份有限公司新闻中心发布的企业动态。`}
  image={item.data.image?.src}
  alternate="/en/news/"
>
  {originalPage ? <NewsRecord page={originalPage}/> : <>
  <section class="record-heading wrap news-record-heading"><nav class="breadcrumbs" aria-label="当前位置"><a href="/">首页</a><span>/</span><a href="/news/">新闻中心</a></nav><p class="eyebrow">{label}</p><h1>{display}</h1><time datetime={item.data.date}>{formatNewsDate(item.data.date)}</time></section>
  <div class="wrap news-reading-layout"><article class="prose-site news-record-body">{item.data.summary&&<p>{item.data.summary}</p>}{original?.bodyHtml&&<div class="archive-content news" set:html={original.bodyHtml}/>} {hasBody&&<Content/>}{item.data.image&&!original?.image&&<figure><img src={item.data.image.src} alt={item.data.image.alt} loading="lazy"/><figcaption class="media-note">{item.data.image.alt}</figcaption></figure>}<a class="text-link" href="/news/">返回新闻中心</a></article><aside><p class="eyebrow">相关阅读</p>{related.map(entry=><a href={getNewsHref(entry.data.slug)}><time datetime={entry.data.date}>{formatNewsDate(entry.data.date)}</time><h2>{entry.data.title}</h2></a>)}</aside></div>
  </>}
</BaseLayout>
