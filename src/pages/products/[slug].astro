---
import { render, type CollectionEntry } from "astro:content";
import ProductGallery from "../../components/product/ProductGallery.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import catalog from "../../data/project-catalog.json";
import {business} from "../../data/business";
import { getPublishedProducts } from "../../lib/products";

export async function getStaticPaths() {
  const products = await getPublishedProducts();
  return products.map((product) => ({
    params: { slug: product.data.slug },
    props: { product },
  }));
}

interface Props {
  product: CollectionEntry<"products">;
}

const { product } = Astro.props;
const { Content } = await render(product);
const category=business.find(b=>b.slug===product.data.slug)?.category;
const related=catalog.filter(p=>p.categories.includes(category||""));
const detailedPages: Record<string, string> = {
  'super-high-rise-steel-building': '/article/gjg.html',
  'long-span-space-steel-building': '/article/mkhgjg.html',
  'prefabricated-steel-building': '/article/zpsjz.html',
  'steel-urban-facility': '/article/zpsgjgcsyycp.html',
  'steel-villa-house': '/article/gjgxcbscp.html',
};
---

<BaseLayout
  title={product.data.seo.title}
  description={product.data.seo.description}
  image={product.data.images[0].src}
>
  <section class="wrap business-detail-head"><nav class="breadcrumbs" aria-label="当前位置"><a href="/">首页</a><span>/</span><a href="/projects/">业务与案例</a><span>/</span><span>{product.data.title}</span></nav><div class="business-detail-grid"><ProductGallery images={product.data.images}/><div><h1>{product.data.title}</h1><p>{product.data.summary}</p><a class="button green" href="/contact/">咨询该业务</a></div></div></section>
  <section class="wrap business-detail-body"><article class="prose-site"><Content/><p><a class="text-link" href={detailedPages[product.data.slug]}>了解业务详情</a></p></article><aside><h2>业务资料</h2><dl class="parameter-list">{product.data.specifications.map(s=><div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}</dl></aside></section>
  <section class="wrap business-case-entry"><div><h2>本业务的工程案例</h2><p>了解 {related.length} 个相关工程的项目概况与建造实践。</p></div><a href={`/projects/?category=${encodeURIComponent(category||'全部工程')}`}>查看{category}工程案例</a></section>
</BaseLayout>
