---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectDetail from '../../components/project/ProjectDetail.astro';
import catalog from '../../data/project-catalog.json';
import { getPublishedProjects } from '../../lib/projects';
export async function getStaticPaths(){return (await getPublishedProjects()).map(project=>({params:{slug:project.data.slug},props:{project}}));}
interface Props { project: CollectionEntry<'projects'>; }
const {project}=Astro.props;
const matches:Record<string,string>={'longgang-fourth-hospital':'/article/detail/28.html','t-box-z1-smart-pavilion':'/article/detail/264.html'};
const full=catalog.find(p=>p.title===project.data.title||p.path===matches[project.data.slug]);
if(!full)throw new Error(`Missing complete project record: ${project.data.slug}`);
const {Content}=await render(project);
---
<Layout title={project.data.seo.title} description={project.data.seo.description} image={full.images[0]?.src} showInquiry={false}>
<ProjectDetail project={full}><details class="supplementary-record"><summary>项目补充说明与参数</summary><article class="prose-site"><Content/></article><dl class="parameter-list">{project.data.specifications.map(s=><div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}</dl></details></ProjectDetail>
</Layout>
