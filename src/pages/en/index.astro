---
import body from '../../data/original-home-en.html?raw';
import SeoHead from '../../components/SeoHead.astro';
import { getCompany } from '../../i18n/ui';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { siteConfig } from '../../../site.config';
const [beforeFooter,afterFooter]=body.split('<!-- SITE_FOOTER -->');
const company=getCompany('en');
const homeTitle='GSIN | Steel Structure & Prefabricated Construction';
const homeDescription='Founded in 1998 in Shenzhen, GSIN provides design, factory fabrication and installation for super high-rise, long-span and prefabricated steel structures.';
const siteUrl=siteConfig.siteUrl??'https://www.szgsin.com/';
const absoluteUrl=(path:string)=>new URL(path,siteUrl).toString();
const siteHomeUrl=absoluteUrl('/');
const englishHomeUrl=absoluteUrl('/en/');
const organizationId=absoluteUrl('/#organization');
const websiteId=absoluteUrl('/#website');
const structuredData=JSON.stringify({
  '@context':'https://schema.org',
  '@graph':[
    {
      '@type':'Organization',
      '@id':organizationId,
      name:company.name,
      alternateName:['GSIN','Shenzhen GSIN Green Building Co., Ltd.'],
      url:siteHomeUrl,
      logo:absoluteUrl(company.logo),
      foundingDate:company.founded,
      telephone:company.phone,
      email:company.email,
      address:{
        '@type':'PostalAddress',
        streetAddress:company.address,
        addressLocality:'Shenzhen',
        addressRegion:'Guangdong',
        addressCountry:'CN',
      },
    },
    {
      '@type':'WebSite',
      '@id':websiteId,
      url:siteHomeUrl,
      name:'GSIN',
      publisher:{'@id':organizationId},
    },
    {
      '@type':'WebPage',
      '@id':englishHomeUrl+'#webpage',
      url:englishHomeUrl,
      name:homeTitle,
      description:homeDescription,
      isPartOf:{'@id':websiteId},
      about:{'@id':organizationId},
      inLanguage:'en',
    },
  ],
});
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><SeoHead title={homeTitle} description={homeDescription} lang="en" structuredData={structuredData}/><link rel="stylesheet" href="/replica/skin/jx/css/reset.css"/><link rel="stylesheet" href="/replica/skin/jx/css/fullpage.min.css"/><link rel="stylesheet" href="/replica/skin/jx/css/style.css"/><link rel="stylesheet" href="/replica/home.css"/><script is:inline src="/replica/skin/jx/js/jquery.min.js"></script></head><body><SiteHeader home lang="en"/><Fragment set:html={beforeFooter}/><SiteFooter lang="en"/><Fragment set:html={afterFooter}/><script is:inline src="/replica/skin/jx/js/fullpage.min.js"></script><script is:inline src="/replica/skin/jx/js/jquery.flexslider.js"></script><script is:inline src="/replica/skin/jx/js/jquery.counterup.js"></script><script is:inline src="/replica/skin/jx/js/main.js"></script><script is:inline src="/replica/home.js"></script></body></html>
