---
import Layout from '../../layouts/Layout.astro';
import CorporateRecord from '../../components/records/CorporateRecord.astro';
import archiveEn from '../../data/archive-en.json';
const page=archiveEn.find(p=>p.path==='/page/gsjs.html')!;
const title='About GSIN | Shenzhen Steel Structure Contractor';
const description='Founded in 1998 in Shenzhen, GSIN holds Grade I steel-structure and Grade II construction qualifications and delivers high-rise, long-span and prefabricated buildings.';
---
<Layout title={title} description={description} showInquiry={false} lang="en"><CorporateRecord page={page} lang="en"/></Layout>
