import CorporateRecord from '../../components/records/CorporateRecord.astro';
import archiveEn from '../../data/archive-en.json';
import { getCompany } from '../../i18n/ui';
const company=getCompany('en');
const page=archiveEn.find(p=>p.path==='/page/gsjs.html')!;
