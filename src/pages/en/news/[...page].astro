---
import type {PaginateFunction} from 'astro';
import {getNewsCatalog} from '../../../lib/catalog';
import NewsListing from '../../../components/pages/NewsListing.astro';
export function getStaticPaths({paginate}:{paginate:PaginateFunction}){return paginate(getNewsCatalog('en'),{pageSize:12});}
const {page}=Astro.props;
---
<NewsListing page={page} lang="en"/>
